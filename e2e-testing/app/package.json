{
  "name": "@opentrons/e2e-app",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for the Opentrons desktop application (Electron)",
  "packageManager": "pnpm@10.6.5",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --project=electron-app",
    "test:headed": "playwright test --project=electron-app --headed",
    "test:debug": "playwright test --project=electron-app --headed --debug",
    "test:ui": "playwright test --project=electron-app --ui",
    "test:dev": "playwright test --project=electron-dev",
    "test:dev:headed": "playwright test --project=electron-dev --headed",
    "test:dev:debug": "playwright test --project=electron-dev --headed --debug",
    "test:all": "playwright test",
    "report": "playwright show-report test-results/html-report",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && tsc --noEmit",
    "prep": "biome check --fix . && biome format --write . && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
