{
  "$id": "opentronsAICommandSchemaV1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    { "$ref": "opentronsCommandSchemaV17" },
    {
      "type": "object",
      "properties": {
        "tipRack": {
          "description": "Tip rack labwareDefURI used for this step",
          "type": "string"
        },
        "nozzles": {
          "type": "string",
          "enum": [
            "SINGLE",
            "ROW",
            "COLUMN",
            "QUADRANT",
            "ALL",
            "PARTIAL_COLUMN"
          ]
        },
        "primaryNozzle": {
          "type": "string",
          "enum": ["A1", "A12", "H1", "H12", "B1", "C1", "D1", "E1", "F1", "G1"]
        }
      }
    },
    {
      "if": {
        "properties": { "commandType": { "const": "aspirate" } },
        "required": ["commandType"]
      },
      "then": {
        "required": ["tipRack", "nozzles", "primaryNozzle"]
      }
    },
    {
      "if": {
        "properties": { "commandType": { "const": "dispense" } },
        "required": ["commandType"]
      },
      "then": {
        "required": ["tipRack", "nozzles", "primaryNozzle"]
      }
    },
    {
      "if": {
        "properties": { "commandType": { "const": "pickUpTip" } },
        "required": ["commandType"]
      },
      "then": {
        "required": ["nozzles", "primaryNozzle"]
      }
    }
  ]
}
