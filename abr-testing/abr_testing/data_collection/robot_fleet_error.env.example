# Copy to robot_fleet_error.env (or pass --env-file) and fill in values each run.
# Ticket field defaults (issue type, priority, description) are code constants.
# The only secret is ABR_JIRA_API_TOKEN.

# Machine-local paths
ABR_STORAGE_DIRECTORY=/Users/someone/abr-ticketing
ABR_ROBOT_SSH_KEY_PATH=/Users/someone/abr-ticketing/robot_key

# Jira connection (email is not a secret; API token is)
ABR_JIRA_URL=https://opentrons.atlassian.net
ABR_JIRA_EMAIL=you@opentrons.com
ABR_JIRA_API_TOKEN=your-atlassian-api-token

# Per-run targets
ABR_ROBOT_IPS=10.0.0.1 10.0.0.2
ABR_JIRA_PROJECT_KEY=RQA
ABR_CLEANUP_KEEP_COUNT=3
