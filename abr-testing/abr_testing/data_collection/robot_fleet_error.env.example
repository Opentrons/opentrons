# Copy to robot_fleet_error.env (or pass --env-file) and fill in local values.
# All machine/user-specific settings for this script live in this one file.

ABR_STORAGE_DIRECTORY=/Users/someone/abr-ticketing
ABR_ROBOT_SSH_KEY_PATH=/Users/someone/abr-ticketing/robot_key
ABR_JIRA_URL=https://opentrons.atlassian.net
ABR_JIRA_EMAIL=you@opentrons.com
ABR_JIRA_API_TOKEN=your-atlassian-api-token
ABR_JIRA_PROJECT_KEY=RQA
ABR_CLEANUP_KEEP_COUNT=3
